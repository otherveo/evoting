APP_NAME="DigiVoting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://evoting.sekolah.sch.id
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=evoting_app
DB_PASSWORD=
DB_SEARCH_PATH=evoting
DB_SSLMODE=require
DB_PERSISTENT=true

TRUSTED_PROXIES=
# Set only when Laravel receives Cloudflare directly and Nginx does not restore the client IP.
SECURITY_CLOUDFLARE_RANGES=
SECURITY_ORIGIN_MODE=enforce
SECURITY_WHITELIST_MODE=enforce
SECURITY_CSP_MODE=report
SECURITY_HSTS_MAX_AGE=86400
STAFF_DB_USERNAME=evoting_staff
STAFF_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=paslon-foto

VITE_APP_NAME="${APP_NAME}"
